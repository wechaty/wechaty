{
  "name": "wechaty-grpc",
  "version": "2.0.0-alpha.19",
  "description": "gRPC for Wechaty",
  "type": "module",
  "exports": {
    ".": {
      "wechaty-source": "./src/mod.ts",
      "types": "./dist/esm/src/mod.d.ts",
      "import": "./dist/esm/src/mod.js"
    }
  },
  "types": "./dist/esm/src/mod.d.ts",
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "generate": "node scripts/generate-stub.ts",
    "clean": "shx rm -fr dist/* out/*",
    "prebuild": "npm run generate",
    "build": "tsc",
    "dist": "npm run clean && npm run build && npm run dist:copy",
    "dist:copy": "shx cp -R out proto commonjs dist/esm/",
    "prelint:ts": "npm run generate",
    "lint": "npm run lint:biome && npm run lint:ts && npm run lint:md",
    "lint:biome": "biome lint scripts src tests commonjs examples",
    "lint:ts": "tsc --isolatedModules --noEmit",
    "lint:md": "markdownlint --config ../../.markdownlint.json README.md",
    "pretest:unit": "npm run generate",
    "test:unit": "node --test src tests/unit",
    "pretest:unit:deno": "npm run generate",
    "test:unit:deno": "env -i PATH=\"$PATH\" HOME=\"$HOME\" CI=\"${CI:-}\" deno test --no-check --allow-read=.,../../node_modules,/tmp --allow-write=/tmp --allow-env --allow-net=127.0.0.1 src tests/unit",
    "test:pack": "bash -x scripts/npm-pack-testing.sh",
    "precoverage:node": "npm run generate",
    "coverage:node": "node ../../scripts/coverage.ts node",
    "precoverage:deno": "npm run generate",
    "coverage:deno": "node ../../scripts/coverage.ts deno",
    "test": "npm run lint && npm run test:unit",
    "prepare": "npm run generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wechaty/wechaty.git",
    "directory": "packages/wechaty-grpc"
  },
  "keywords": [
    "grpc",
    "chatie",
    "chatbot",
    "hostie",
    "puppet",
    "wechaty"
  ],
  "author": "Huan Li <huan@chatie.io>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/wechaty/wechaty/issues"
  },
  "homepage": "https://github.com/wechaty/wechaty/tree/main/packages/wechaty-grpc#readme",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "google-protobuf": "^3.21.4",
    "stronger-typed-streams": "^0.2.0"
  },
  "devDependencies": {
    "@types/google-protobuf": "^3.15.12",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "grpc-tools": "1.13.1",
    "shx": "^0.3.4",
    "ts-protoc-gen": "^0.15.0"
  },
  "files": [
    "dist/",
    "proto/",
    "src/"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
