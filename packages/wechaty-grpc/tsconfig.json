{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/esm",
    "types": [ "node" ]
  },
  "exclude": [
    "node_modules/",
    "dist/",
    "out/",
    "tests/fixtures/smoke-testing.ts"
  ],
