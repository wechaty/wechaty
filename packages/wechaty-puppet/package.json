{
  "name": "wechaty-puppet",
  "version": "2.0.0-alpha.20",
  "description": "Abstract Puppet for Wechaty",
  "type": "module",
  "exports": {
    ".": {
      "wechaty-source": "./src/mods/mod.ts",
      "types": "./dist/esm/src/mods/mod.d.ts",
      "import": "./dist/esm/src/mods/mod.js"
    },
    "./filters": {
      "wechaty-source": "./src/mods/filters.ts",
      "types": "./dist/esm/src/mods/filters.d.ts",
      "import": "./dist/esm/src/mods/filters.js"
    },
    "./helpers": {
      "wechaty-source": "./src/mods/helpers.ts",
      "types": "./dist/esm/src/mods/helpers.d.ts",
      "import": "./dist/esm/src/mods/helpers.js"
    },
    "./impls": {
      "wechaty-source": "./src/mods/impls.ts",
      "types": "./dist/esm/src/mods/impls.d.ts",
      "import": "./dist/esm/src/mods/impls.js"
    },
    "./payloads": {
      "wechaty-source": "./src/mods/payloads.ts",
      "types": "./dist/esm/src/mods/payloads.d.ts",
      "import": "./dist/esm/src/mods/payloads.js"
    },
    "./types": {
      "wechaty-source": "./src/mods/types.ts",
      "types": "./dist/esm/src/mods/types.d.ts",
      "import": "./dist/esm/src/mods/types.js"
    }
  },
  "types": "./dist/esm/src/mods/mod.d.ts",
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "clean": "shx rm -fr dist/*",
    "dist": "npm run clean && npm run build",
    "lint": "npm run lint:biome && npm run lint:ts && npm run lint:md",
    "lint:biome": "biome lint src tests",
    "lint:ts": "tsc --isolatedModules --noEmit",
    "lint:md": "markdownlint --config ../../.markdownlint.json README.md",
    "test:unit": "node --test src tests/unit",
    "test:unit:deno": "env -i PATH=\"$PATH\" HOME=\"$HOME\" CI=\"${CI:-}\" deno test --no-check --allow-read=.,../../node_modules,/tmp --allow-write=/tmp --allow-env src tests/unit",
    "test:pack": "bash -x scripts/npm-pack-testing.sh",
    "coverage:node": "node ../../scripts/coverage.ts node",
    "coverage:deno": "node ../../scripts/coverage.ts deno",
    "test": "npm run lint && npm run test:unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wechaty/wechaty.git",
    "directory": "packages/wechaty-puppet"
  },
  "keywords": [
    "chatie",
    "wechaty",
    "wechat",
    "chatbot",
    "bot",
    "sdk"
  ],
  "author": "Huan Li <huan@chatie.io>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/wechaty/wechaty/issues"
  },
  "homepage": "https://github.com/wechaty/wechaty/tree/main/packages/wechaty-puppet#readme",
  "dependencies": {
    "brolog": "^2.0.0",
    "clone-class": "^1.1.1",
    "file-box": "^2.1.0",
    "fp-ts": "^2.11.5",
    "gerror": "^1.0.16",
    "memory-card": "^1.1.2",
    "quick-lru": "^8.0.0",
    "state-switch": "^2.0.0",
    "typed-emitter": "^1.5.0-from-event",
    "typesafe-actions": "^5.1.0",
    "watchdog": "^0.9.2"
  },
  "devDependencies": {
    "rxjs": "^7.4.0",
    "shx": "^0.3.4",
    "yocto-queue": "^1.0.0"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
