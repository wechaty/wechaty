{
  "name": "wechaty-token",
  "version": "2.0.0-alpha.19",
  "description": "Wechaty Token Based Authentication Manager",
  "type": "module",
  "exports": {
    ".": {
      "wechaty-source": "./src/mod.ts",
      "types": "./dist/esm/src/mod.d.ts",
      "import": "./dist/esm/src/mod.js"
    }
  },
  "types": "./dist/esm/src/mod.d.ts",
  "bin": {
    "wechaty-token": "dist/esm/bin/cli.js"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "clean": "shx rm -fr dist/*",
    "dist": "npm run clean && npm run build",
    "cli": "node bin/cli.ts",
    "lint": "npm run lint:biome && npm run lint:ts && npm run lint:md",
    "lint:biome": "biome lint bin src tests",
    "lint:ts": "tsc --isolatedModules --noEmit",
    "lint:md": "markdownlint --config ../../.markdownlint.json README.md",
    "test:unit": "node --test src",
    "test:unit:deno": "env -i PATH=\"$PATH\" HOME=\"$HOME\" CI=\"${CI:-}\" deno test --no-check --allow-read=.,../../node_modules,/tmp --allow-write=/tmp --allow-env src",
    "test:pack": "bash -x scripts/npm-pack-testing.sh",
    "coverage:node": "node ../../scripts/coverage.ts node",
    "coverage:deno": "node ../../scripts/coverage.ts deno",
    "test": "npm run lint && npm run test:unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wechaty/wechaty.git",
    "directory": "packages/wechaty-token"
  },
  "keywords": [
    "wechaty",
    "token"
  ],
  "author": "Huan Li <huan@chatie.io>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/wechaty/wechaty/issues"
  },
  "homepage": "https://github.com/wechaty/wechaty/tree/main/packages/wechaty-token#readme",
  "dependencies": {
    "brolog": "^2.0.0",
    "cmd-ts": "^0.10.2",
    "cockatiel": "^4.0.0"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.14.0"
  },
  "devDependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "shx": "^0.3.4"
  },
  "files": [
    "bin/",
    "dist/",
    "src/"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
