{
  "name": "wechaty-puppet-service",
  "version": "2.0.0-alpha.19",
  "description": "Puppet Service for Wechaty",
  "type": "module",
  "exports": {
    ".": {
      "wechaty-source": "./src/mod.ts",
      "types": "./dist/esm/src/mod.d.ts",
      "import": "./dist/esm/src/mod.js"
    }
  },
  "types": "./dist/esm/src/mod.d.ts",
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc",
    "clean": "shx rm -fr dist/*",
    "dist": "npm run clean && npm run build",
    "start": "node --conditions=wechaty-source examples/ding-dong-bot.ts",
    "lint": "npm run lint:biome && npm run lint:ts && npm run lint:md",
    "lint:biome": "biome lint src tests examples",
    "lint:ts": "tsc --isolatedModules --noEmit",
    "lint:md": "markdownlint --config ../../.markdownlint.json README.md",
    "test:unit": "node --conditions=wechaty-source --test --test-timeout=60000 src tests/unit",
    "test:unit:deno": "env -i PATH=\"$PATH\" HOME=\"$HOME\" CI=\"${CI:-}\" deno test --no-check --allow-read=.,../../node_modules,../wechaty-grpc,/etc/alpine-release,/tmp --allow-write=/tmp --allow-env --allow-net=127.0.0.1,localhost,0.0.0.0 --allow-sys=hostname --allow-ffi=../../node_modules/leveldown/prebuilds --conditions=wechaty-source src tests/unit",
    "test:pack": "bash -x scripts/npm-pack-testing.sh",
    "coverage:node": "node ../../scripts/coverage.ts node",
    "coverage:deno": "node ../../scripts/coverage.ts deno",
    "test": "npm run lint && npm run test:unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wechaty/wechaty.git",
    "directory": "packages/wechaty-puppet-service"
  },
  "keywords": [
    "chatie",
    "wechaty",
    "chatbot",
    "bot",
    "grpc",
    "wechat",
    "sdk"
  ],
  "author": "Huan Li <huan@chatie.io>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/wechaty/wechaty/issues"
  },
  "homepage": "https://github.com/wechaty/wechaty/tree/main/packages/wechaty-puppet-service#readme",
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-node": "^2.3.0",
    "clone-class": "^1.1.1",
    "file-box": "^2.0.0",
    "flash-store": "^1.3.4",
    "gerror": "^1.0.16",
    "semver": "^7.3.5",
    "stronger-typed-streams": "^0.2.0",
    "wechaty-grpc": "^2.0.0-alpha.19",
    "wechaty-token": "^2.0.0-alpha.19"
  },
  "peerDependencies": {
    "wechaty-puppet": "^2.0.0-alpha.19"
  },
  "devDependencies": {
    "@types/semver": "^7.3.9",
    "@types/temp": "^0.9.1",
    "shx": "^0.3.4",
    "temp": "^0.9.4",
    "wechaty-puppet": "^2.0.0-alpha.19",
    "wechaty-puppet-mock": "^2.0.0-alpha.19"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
