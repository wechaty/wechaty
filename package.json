{
  "name": "wechaty-workspace",
  "private": true,
  "description": "The Wechaty monorepo: the wechaty package and its core libraries, one npm workspace per package under packages/.",
  "type": "module",
  "workspaces": [
    "packages/wechaty-token",
    "packages/wechaty-puppet",
    "packages/wechaty-puppet-mock",
    "packages/wechaty-grpc",
    "packages/wechaty-puppet-service",
    "packages/wechaty"
  ],
  "engines": {
    "node": ">=26",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "dist": "npm run dist --workspaces",
    "lint": "npm run lint:root && npm run lint --workspaces",
    "lint:root": "biome lint scripts && tsc -p tsconfig.json --noEmit && bash -n scripts/*.sh && markdownlint README.md",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "node --test scripts && npm run test:unit --workspaces",
    "test:unit:deno": "env -i PATH=\"$PATH\" HOME=\"$HOME\" CI=\"${CI:-}\" deno test --no-check --allow-read=.,/tmp --allow-write=/tmp --allow-env=TMPDIR,TMP,TEMP --allow-run=git scripts && npm run test:unit:deno --workspaces",
    "test:unit:browser": "wtr --config web-test-runner.config.js",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:pack": "npm run test:pack --workspaces --if-present",
    "test:shell": "shellcheck scripts/*.sh && npm run test:shell --workspaces --if-present",
    "coverage": "npm run coverage:node",
    "coverage:node": "npm run coverage:node --workspaces --if-present",
    "coverage:deno": "npm run coverage:deno --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wechaty/wechaty.git"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/dev-server-import-maps": "^0.3.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.2",
    "chai": "^6.3.0",
    "markdownlint-cli": "^0.50.0",
    "node-stdlib-browser": "^1.3.1",
    "rollup-plugin-node-polyfills": "^0.2.1"
  },
  "allowScripts": {
    "grpc-tools@1.13.1": true
  }
}
